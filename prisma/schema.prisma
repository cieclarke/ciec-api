generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tag {
  id     String  @id @db.VarChar(12)
  name   String  @db.LongText
  images Image[]
}

model Image {
  id          String @id @db.VarChar(12)
  format      String @db.VarChar(10)
  description String @db.LongText
  tags        Tag[]
  width       Int
  height      Int
}