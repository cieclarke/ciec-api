{
  "name": "image-hosting-api",
  "version": "1.0.0",
  "description": "Hosted image API that serves multiple sizes generated from a master image",
  "main": "server.js",
  "author": {
    "name": "cc"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate:push": "prisma db push",
    "migrate:pull": "prisma db pull",
    "migrate:generate": "prisma generate",
    "prisma:skills": "prisma skills sync",
    "migrate_prod": "export DATABASE_URL='mysql://ciec:BxCRbntTq6KosqP@localhost:3306/cieclar1_api' && prisma db push",
