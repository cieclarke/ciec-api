    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/config": "^6.12.0",
    "express": "^4.19.2",
    "mime-types": "^2.1.35",
    "multer": "^2.4.0",
    "nanoid": "^3.3.7",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "prisma": "^8.0.0-rc.19"
  },
